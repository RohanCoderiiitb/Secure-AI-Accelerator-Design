    "n_secrets": 256,
    "min": -128,
    "max": 127
  },
  "prior": "uniform, pi(w) = 1/256",
  "observation_definition": "per-cycle power proxy (P_reg, P_comb, P_tot); one channel C[w,o]=P(o|w) per clock cycle from qif_channel.build_per_cycle, shared with the MI computation",
