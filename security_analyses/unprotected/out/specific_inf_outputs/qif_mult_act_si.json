  "channel_exactness_at_report_cycle": {
    "P_reg": true,
    "P_comb": true,
    "P_tot": true
  },
  "caveats": {
    "pe_conditional_on_psum_in_zero": false,
    "zero_delay_hd_proxies_have_no_glitches": true,
    "interpretation": "Zero-delay Hamming-distance proxies contain no glitches, so these SI values are a lower bound on gate-level leakage and an upper bound with respect to measurement noise."
